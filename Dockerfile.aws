# Build the student and admin SPAs once, then run the Node API against them.
FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY evals/package.json evals/package.json
RUN npm ci

COPY . .
RUN npm run build --workspace=llteacher-web && npm run build --workspace=llteacher-admin

FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS runtime

WORKDIR /app
# The knowledge base is an OKF bundle served by the pinned okf binary
# (search, validate, create); poppler renders scanned-PDF pages for OCR.
ARG TARGETARCH
ARG OKF_VERSION=0.3.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl poppler-utils \
  && curl -fsSL -o /tmp/okf "https://github.com/okf-memory/okf-agent-memory/releases/download/v${OKF_VERSION}/okf-linux-${TARGETARCH}" \
  && curl -fsSL -o /tmp/checksums.txt "https://github.com/okf-memory/okf-agent-memory/releases/download/v${OKF_VERSION}/checksums.txt" \
  && cd /tmp && grep -E ' +bin/okf-linux-'"${TARGETARCH}"'$' checksums.txt | sed -E 's# +bin/okf-linux-'"${TARGETARCH}"'$#  okf#' > okf.sha256 && test -s okf.sha256 && sha256sum -c okf.sha256 \
  && install -m 0755 /tmp/okf /usr/local/bin/okf \
  && apt-get purge -y curl && apt-get autoremove -y \
  && rm -rf /tmp/okf /tmp/checksums.txt /var/lib/apt/lists/*
ENV NODE_ENV=production \
    PORT=8080

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web/package.json apps/web/package.json
COPY --from=build /app/apps/web/src apps/web/src
# Operational runners live outside src; src above includes db/migrations.
COPY --from=build /app/apps/web/scripts/migrate.ts apps/web/scripts/migrate.ts
COPY --from=build /app/apps/web/scripts/seed.ts apps/web/scripts/seed.ts
COPY --from=build /app/apps/web/dist apps/web/dist
COPY --from=build /app/apps/admin/package.json apps/admin/package.json
COPY --from=build /app/apps/admin/dist apps/admin/dist
COPY --from=build /app/packages/ui/package.json packages/ui/package.json
COPY --from=build /app/packages/ui/src packages/ui/src

USER node
EXPOSE 8080

CMD ["npm", "run", "node:serve"]
