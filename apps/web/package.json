{
  "name": "llteacher-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run copy-webr-assets",
    "dev": "vite",
    "prebuild": "npm run copy-webr-assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx src/server/node.ts",
    "deploy": "npm run db:migrate && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-webr-assets": "node scripts/copy-webr-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.106",
    "@ai-sdk/react": "2.0.197",
    "@hono/node-server": "^2.1.1",
    "@llteacher/ui": "*",
    "@neondatabase/serverless": "^0.10.0",
    "@types/pg": "^8.11.0",
    "@workos-inc/node": "^7.0.0",
    "ai": "5.0.195",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "katex": "^0.16.47",
    "pg": "^8.13.0",
    "react": "^19.2.1",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "webr": "0.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.28.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.97.0"
  }
}
