DATABASE_URL="postgresql://user:password@host.neon.tech/llteacher?sslmode=require"
WORKOS_API_KEY="sk_test_placeholder"
WORKOS_CLIENT_ID="client_placeholder"
OPENROUTER_API_KEY="sk-or-v1-placeholder"
# UW SSEC's LiteLLM gateway (#178).
LLMOXIE_API_KEY="llmoxie-key-placeholder"
# Overrides the gateway host; unset (or empty) falls through to
# LLMOXIE_DEFAULT_BASE_URL in lib/ai.ts, which is the -prod host. Set this
# for local/preview so student traffic does not go to -prod, and to recover
# without a redeploy if the Azure Container Apps environment is ever
# recreated (the hostname's `lemonmoss-19296c81` segment is generated and
# does not survive that).
#
# #317 review, #348: left commented out, this line's own value WAS the trap
# it describes -- a copied .dev.vars leaves the binding unset and every
# local chat turn (and every /llm-models discovery call) bills and logs
# against production, exactly what the paragraph above warns against.
# Uncommented with an intentionally non-resolving placeholder instead: local
# dev must fail closed (a connection error) and prompt filling in the real
# non-prod gateway URL, rather than silently and successfully hitting prod.
LLMOXIE_BASE_URL="https://your-nonprod-gateway.example/v1"

# Auth (M1): 32-byte keys, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="base64-encoded-32-byte-key"
ENCRYPTION_KEY="base64-encoded-32-byte-key"
BLIND_INDEX_KEY="base64-encoded-32-byte-key"

# Webhook signing secret from the WorkOS dashboard's Webhooks/Endpoints
# page (issue #95) -- not a key you generate yourself.
WORKOS_WEBHOOK_SECRET="whsec_placeholder"

# --- #343: opt-in degradation when the platform gateway key is missing ------
# Migration 0035 makes llmoxie every org's default provider with no credential
# row, so an unset LLMOXIE_API_KEY is a 500 for every student on every turn --
# and a Worker rollback does not fix it, because the DB rows are already
# flipped.
#
# Set this to a model your OPENROUTER_API_KEY can actually serve and chat
# degrades to OpenRouter instead of failing, logging loudly each turn. Leave it
# unset (the default) and behaviour is unchanged: a missing platform credential
# fails loudly rather than quietly answering from a model nobody chose.
#
# There is deliberately no default value -- an LLMoxie catalogue name like
# `gpt-5.3-codex` is not an OpenRouter slug, so the substitute has to be a
# deployment decision, not a guess baked into the code.
# LLM_DEGRADED_FALLBACK_MODEL="vendor/some-model"
