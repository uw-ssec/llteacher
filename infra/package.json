{
  "name": "infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pulumi:local": "npm run build && PULUMI_BACKEND_URL=file://$PWD/.pulumi/local pulumi --stack local",
    "pulumi:cloud": "npm run build && PULUMI_BACKEND_URL=https://api.pulumi.com pulumi"
  },
  "dependencies": {
    "@pulumi/aws": "^7.46.0",
    "@pulumi/pulumi": "^3.262.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
